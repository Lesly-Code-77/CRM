# Base PostgreSQL (local : docker compose up -d ; prod : Azure Database for PostgreSQL, région France)
DATABASE_URL="postgresql://salesflow:salesflow@localhost:5432/salesflow?schema=public"

# Mode démo : connexion par choix d'utilisateur, IA simulée. Mettre à "false" une fois Entra ID branché.
DEMO_MODE="true"

