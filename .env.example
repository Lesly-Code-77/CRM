# Base PostgreSQL (local : docker compose up -d ; prod : Azure Database for PostgreSQL, région France)
DATABASE_URL="postgresql://salesflow:salesflow@localhost:5432/salesflow?schema=public"

# Mode démo : connexion par choix de profil fictif. Mettre à "false" en production.
DEMO_MODE="true"

# Adresse publique de l'application (sert à construire l'URL de retour Microsoft)
APP_URL="http://localhost:3000"

# Connexion Microsoft Entra ID — App registration « SalesFlow » (multi-locataire)
# Redirect URI à déclarer dans Azure : <APP_URL>/api/auth/callback
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
