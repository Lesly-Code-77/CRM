# ── Base de données PostgreSQL ─────────────────────────────────────────────
# Supabase : bouton « Connect » → onglet « ORMs » → Prisma. Remplacer [YOUR-PASSWORD].
#   DATABASE_URL : pooler « Transaction » (port 6543) — utilisé par l'application
#   DIRECT_URL   : pooler « Session » (port 5432) — utilisé par les migrations, le seed et l'outil admin
# Ajouter &sslmode=require à la fin des deux adresses Supabase.
DATABASE_URL="postgresql://salesflow:salesflow@localhost:5432/salesflow?schema=public"
# DIRECT_URL=""

# ── Mode démo ──────────────────────────────────────────────────────────────
# Connexion par profils fictifs. Mettre à "false" en production.
DEMO_MODE="true"
# Code à saisir avant de voir les profils (conseillé dès que la démo est en ligne). Vide = pas de code.
DEMO_ACCESS_CODE=""

# ── Adresse de l'application ───────────────────────────────────────────────
# Sert à construire l'URL de retour Microsoft. En ligne : https://<votre-site>.netlify.app
APP_URL="http://localhost:3000"

# ── Connexion Microsoft Entra ID (facultatif en démo) ──────────────────────
# App registration « SalesFlow » (multi-locataire). Redirect URI : <APP_URL>/api/auth/callback
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
